<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dong.classic.mapper.ClassicSigninRecordMapper">

    <!-- 签到流水。位图管高性能判断，本表管持久化与对账 -->

    <resultMap id="recordMap" type="com.dong.classic.entity.ClassicSigninRecord">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="sign_date" property="signDate"/>
        <result column="continuous_days" property="continuousDays"/>
        <result column="source" property="source"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="columns">
        id, user_id, sign_date, continuous_days, source, create_time
    </sql>

    <!-- insert ignore：重复签到撞唯一键时返回 0，不报错，与位图的幂等语义一致 -->
    <insert id="insertIgnore" parameterType="com.dong.classic.entity.ClassicSigninRecord"
            useGeneratedKeys="true" keyProperty="id">
        insert ignore into classic_signin_record (user_id, sign_date, continuous_days, source)
        values (#{userId}, #{signDate}, #{continuousDays}, #{source})
    </insert>

    <select id="selectByUserId" resultMap="recordMap">
        select
        <include refid="columns"/>
        from classic_signin_record
        where user_id = #{userId}
        order by sign_date desc
        limit #{limit}
    </select>

    <select id="countByDate" resultType="long">
        select count(*)
        from classic_signin_record
        where sign_date = #{signDate}
    </select>

    <delete id="clearAll">
        delete from classic_signin_record
    </delete>

</mapper>
