<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dong.crossborder.mapper.FxRateMapper">

    <!-- 汇率牌价表。牌价以美元为桥存「一美元兑多少该币种」，
         任意两币种的汇率由各自对美元的牌价相除得出 -->

    <resultMap id="rateMap" type="com.dong.crossborder.entity.FxRate">
        <id column="id" property="id"/>
        <result column="currency" property="currency"/>
        <result column="usd_rate" property="usdRate"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="columns">
        id, currency, usd_rate, status, create_time, update_time
    </sql>

    <!-- 只取启用状态的牌价，停用币种等同下架 -->
    <select id="selectByCurrency" resultMap="rateMap">
        select
        <include refid="columns"/>
        from cross_border_fx_rate
        where currency = #{currency}
          and status = 1
    </select>

    <select id="selectAll" resultMap="rateMap">
        select
        <include refid="columns"/>
        from cross_border_fx_rate
        order by currency asc
    </select>

    <insert id="insert" parameterType="com.dong.crossborder.entity.FxRate"
            useGeneratedKeys="true" keyProperty="id">
        insert into cross_border_fx_rate (currency, usd_rate, status)
        values (#{currency}, #{usdRate}, #{status})
    </insert>

    <update id="updateRate">
        update cross_border_fx_rate
        set usd_rate    = #{usdRate},
            update_time = now()
        where currency = #{currency}
    </update>

</mapper>
