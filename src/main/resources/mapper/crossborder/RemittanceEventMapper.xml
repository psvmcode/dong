<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dong.crossborder.mapper.RemittanceEventMapper">

    <!-- 汇款单流转日志。只增不改，成功与被拒绝都记，
         出问题时靠它还原这笔钱经历过什么 -->

    <resultMap id="eventMap" type="com.dong.crossborder.entity.RemittanceEvent">
        <id column="id" property="id"/>
        <result column="remittance_no" property="remittanceNo"/>
        <result column="from_status" property="fromStatus"/>
        <result column="to_status" property="toStatus"/>
        <result column="event" property="event"/>
        <result column="result" property="result"/>
        <result column="reason" property="reason"/>
        <result column="operator" property="operator"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="columns">
        id, remittance_no, from_status, to_status, event, result, reason, operator, create_time
    </sql>

    <insert id="insert" parameterType="com.dong.crossborder.entity.RemittanceEvent"
            useGeneratedKeys="true" keyProperty="id">
        insert into cross_border_remittance_event (remittance_no, from_status, to_status, event, result, reason,
                                                  operator)
        values (#{remittanceNo}, #{fromStatus}, #{toStatus}, #{event}, #{result}, #{reason}, #{operator})
    </insert>

    <select id="selectByRemittanceNo" resultMap="eventMap">
        select
        <include refid="columns"/>
        from cross_border_remittance_event
        where remittance_no = #{remittanceNo}
        order by id asc
    </select>

    <delete id="clearAll">
        delete from cross_border_remittance_event
    </delete>

</mapper>
