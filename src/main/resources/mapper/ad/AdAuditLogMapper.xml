<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dong.ad.mapper.AdAuditLogMapper">

    <resultMap id="auditMap" type="com.dong.ad.entity.AdAuditLog">
        <id column="id" property="id"/>
        <result column="operator" property="operator"/>
        <result column="action" property="action"/>
        <result column="target_type" property="targetType"/>
        <result column="target_id" property="targetId"/>
        <result column="before_json" property="beforeJson"/>
        <result column="after_json" property="afterJson"/>
        <result column="reason" property="reason"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="auditColumns">
        id, operator, action, target_type, target_id, before_json, after_json, reason, create_time
    </sql>

    <!-- 写入审计记录。审计失败不能影响主流程，由调用方吞异常 -->
    <insert id="insert" parameterType="com.dong.ad.entity.AdAuditLog"
            useGeneratedKeys="true" keyProperty="id">
        insert into ad_audit_log (operator, action, target_type, target_id, before_json, after_json, reason)
        values (#{operator}, #{action}, #{targetType}, #{targetId}, #{beforeJson}, #{afterJson}, #{reason})
    </insert>

    <!-- 分页查审计轨迹 -->
    <select id="selectByPage" resultMap="auditMap">
        select
        <include refid="auditColumns"/>
        from ad_audit_log
        <where>
            <if test="targetType != null and targetType != ''">
                and target_type = #{targetType}
            </if>
            <if test="targetId != null">
                and target_id = #{targetId}
            </if>
            <if test="action != null and action != ''">
                and action = #{action}
            </if>
        </where>
        order by id desc
        limit #{offset}, #{size}
    </select>

    <!-- 统计审计总数，条件与列表一致 -->
    <select id="countByPage" resultType="java.lang.Long">
        select count(*)
        from ad_audit_log
        <where>
            <if test="targetType != null and targetType != ''">
                and target_type = #{targetType}
            </if>
            <if test="targetId != null">
                and target_id = #{targetId}
            </if>
            <if test="action != null and action != ''">
                and action = #{action}
            </if>
        </where>
    </select>

</mapper>
