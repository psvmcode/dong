<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dong.lab.mq.mapper.MqMessageLogMapper">

    <resultMap id="logMap" type="com.dong.lab.mq.entity.MqMessageLog">
        <id column="id" property="id"/>
        <result column="msg_id" property="msgId"/>
        <result column="topic" property="topic"/>
        <result column="payload" property="payload"/>
        <result column="status" property="status" javaType="com.dong.lab.mq.enums.MqMessageStatus"/>
        <result column="retry_count" property="retryCount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 写消息日志，唯一索引实现消费幂等 -->
    <insert id="insert" parameterType="com.dong.lab.mq.entity.MqMessageLog"
            useGeneratedKeys="true" keyProperty="id">
        insert into mq_message_log (msg_id, topic, payload, status, retry_count)
        values (#{msgId}, #{topic}, #{payload}, #{status}, #{retryCount})
    </insert>

    <!-- 按消息 id 查是否已消费 -->
    <select id="countByMsgId" resultType="java.lang.Integer">
        select count(1)
        from mq_message_log
        where msg_id = #{msgId}
    </select>

    <!-- 重试计数累加 -->
    <update id="increaseRetry">
        update mq_message_log
        set retry_count = retry_count + 1
        where msg_id = #{msgId}
    </update>

    <!-- 更新消费状态 -->
    <update id="updateStatus">
        update mq_message_log
        set status = #{status}
        where msg_id = #{msgId}
    </update>

    <!-- 最近消息记录 -->
    <select id="selectRecent" resultMap="logMap">
        select id, msg_id, topic, payload, status, retry_count, create_time, update_time
        from mq_message_log
        order by id desc
        limit #{limit}
    </select>

    <!-- 消息总数 -->
    <select id="countAll" resultType="java.lang.Long">
        select count(1) from mq_message_log
    </select>

</mapper>
