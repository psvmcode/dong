<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 复用 Spring Boot 的默认 pattern 与控制台 appender，保留彩色输出 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 应用名取自 application.yml 的 spring.application.name -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="dong"/>

    <property name="LOG_HOME" value="logs"/>
    <property name="MAX_FILE_SIZE" value="50MB"/>
    <property name="MAX_HISTORY" value="14"/>
    <property name="TOTAL_SIZE_CAP" value="1GB"/>

    <!-- 全量日志：按天滚动，单文件超过阈值再按序号切分，超过总容量自动清理最旧的 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 错误日志单独成文件，排查问题时不用在海量 INFO 里翻 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-error.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- 业务代码保持 INFO。需要看 SQL 时把 com.dong 临时改成 DEBUG，
         MyBatis 已配置 log-impl 为 Slf4jImpl，会连带打印语句与参数 -->
    <logger name="com.dong" level="INFO"/>

    <!-- 以下是中间件与框架的降噪，只压掉高频且无信息量的心跳、重平衡、连接日志 -->

    <!-- 浏览器会自动请求 /favicon.ico，缺该文件时抛 NoResourceFoundException 并打印完整堆栈 -->
    <logger name="org.springframework.web.servlet.resource" level="WARN"/>
    <!-- RocketMQ 重平衡与心跳 -->
    <logger name="org.apache.rocketmq" level="WARN"/>
    <!-- Kafka 未启用时的协调器轮询 -->
    <logger name="org.apache.kafka" level="WARN"/>
    <!-- Netty 的 channel 建立与关闭 -->
    <logger name="io.netty" level="WARN"/>
    <!-- Redisson 的连接与看门狗续期 -->
    <logger name="org.redisson" level="WARN"/>
    <!-- MongoDB 驱动的心跳与集群监控 -->
    <logger name="org.mongodb.driver" level="WARN"/>
    <!-- Elasticsearch 客户端的请求日志 -->
    <logger name="org.elasticsearch" level="WARN"/>
    <logger name="co.elastic.clients" level="WARN"/>
    <!-- MyBatis 自身的初始化日志，SQL 由 com.dong 的级别控制 -->
    <logger name="org.mybatis" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
