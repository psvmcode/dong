<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 复用 Spring Boot 的默认 pattern（含彩色），控制台 appender 自己定义以便加级别过滤 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 应用名取自 application.yml 的 spring.application.name -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="dong"/>

    <property name="LOG_HOME" value="logs"/>
    <property name="MAX_FILE_SIZE" value="50MB"/>
    <property name="MAX_HISTORY" value="14"/>
    <property name="TOTAL_SIZE_CAP" value="1GB"/>

    <!-- 控制台只输出 INFO 及以上。
         文件是全级别的，若控制台不过滤，海量 TRACE 会把终端刷爆、也拖慢启动 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- 全量日志：不做级别过滤，TRACE/DEBUG/INFO/WARN/ERROR 全部落盘 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- DEBUG 单独成文件：排查时不用在全量日志里翻，也不会被 INFO 淹没 -->
    <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-debug.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}-debug.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>DEBUG</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- WARN 单独成文件：降级、重试、配置缺失这类"没失败但要留意"的信号 -->
    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-warn.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}-warn.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- ERROR 单独成文件，排查线上问题时第一时间看它 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-error.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- 业务代码开到 TRACE，保证各级别都有样本落盘。
         MyBatis 的 SQL 在 DEBUG，com.dong 开 TRACE 后会自动带出来 -->
    <logger name="com.dong" level="TRACE"/>

    <!-- 以下是中间件与框架的降噪。
         它们不放开到 TRACE 是有意的：第三方库的 TRACE 量级是业务代码的几十倍，
         放开后一天就能写满几个 GB，且几乎全是内部细节，排查时用不上 -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web.servlet.resource" level="WARN"/>
    <logger name="org.apache.rocketmq" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.redisson" level="WARN"/>
    <logger name="org.mongodb.driver" level="WARN"/>
    <logger name="org.elasticsearch" level="WARN"/>
    <logger name="co.elastic.clients" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>

    <!-- root 定为 INFO：未单独配置的第三方库默认 INFO，不会因为继承 TRACE 而日志爆炸。
         但文件 appender 本身不过滤，所以 com.dong 的 TRACE/DEBUG 照样全部落盘 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="DEBUG_FILE"/>
        <appender-ref ref="WARN_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
